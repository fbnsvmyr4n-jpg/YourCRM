# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local file-backed data store — contains user records incl. password hashes
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local credential notes — never commit
CREDENTIALS.local.txt
*.local.txt
# Every dev database, however it is named.
#
# This was `.dev-db/` and that trailing slash cost 40MB in a public repo: a
# corrupted database was moved aside to `.dev-db.corrupt-<timestamp>` before
# being rebuilt, the pattern did not match the new name, and the next `git add
# -A` committed 1,082 binary heap pages. An ignore rule that only covers the
# happy-path name is not an ignore rule.
.dev-db*

# Text scraped out of a corrupted dev database. Contact data, dev only.
salvaged-dev-records.txt

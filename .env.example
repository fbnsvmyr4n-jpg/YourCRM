# ---------------------------------------------------------------------------
# YourCRM — environment variables
# Copy to `.env.local` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Both of the first two are REQUIRED in production. The app checks them and
# refuses to serve without them — see /api/health, which reports the status of
# each and returns 503 until both are in place.

# REQUIRED IN PRODUCTION — Postgres connection string.
# Without it the app falls back to JSON files under .data/, which is fine for
# local development but does NOT persist on serverless hosts (Vercel, etc.) —
# writes appear to succeed and then vanish.
# Works with any Postgres provider — Neon, Supabase, Railway, RDS.
# Neon: use the POOLED connection string.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# REQUIRED IN PRODUCTION. At least 16 characters.
# Signs the session cookie. The local fallback is a fixed string that lives in
# src/server/auth.ts — so with it, anyone who can read the source can forge a
# session cookie for any account and sign in with no password. Verified.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# OPTIONAL — unlocks the full conversational AI on the Chat Agent screen.
# Without it the assistant still answers real questions about your CRM data
# ("data mode"); with it, it runs a full Claude agent over that same data.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OPTIONAL — enables the password-reset email.
# Free tier at https://resend.com (3,000 emails/month). Without it the reset
# flow still issues a valid token; it just cannot deliver the link by email.
RESEND_API_KEY=

# Optional sender. Defaults to Resend's shared address, which works before
# you have verified a domain of your own.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Billing — Stripe
#
# All OPTIONAL. Without them the Settings page says billing is not configured
# and the plan buttons are unavailable; nothing pretends a subscription exists.
# Trials still work: they are held in the database, not in Stripe.
#
# WITH them, the webhook below becomes the only unauthenticated endpoint in the
# app that writes — so STRIPE_WEBHOOK_SECRET is not optional once a key is set.
# Without the secret the endpoint refuses every request (503) rather than
# trusting the caller.
# ---------------------------------------------------------------------------

# Secret key from https://dashboard.stripe.com/apikeys
# Use the TEST key (sk_test_…) anywhere that is not production. A live key on a
# preview deployment charges real cards.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint, from
# https://dashboard.stripe.com/webhooks — add an endpoint pointing at
#   https://your-domain/api/stripe/webhook
# and subscribe it to:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#
# Locally:  stripe listen --forward-to localhost:3100/api/stripe/webhook
# which prints a whsec_… to use here.
STRIPE_WEBHOOK_SECRET=

# The recurring Price id for each plan — NOT the Product id. Create three
# monthly prices in Stripe ($97 / $297 / $497) and paste their price_… ids.
# These differ between test and live mode; a test id in production matches no
# real subscription, which leaves an agency paying with no plan.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_UNLIMITED=
STRIPE_PRICE_SAAS_PRO=

# Where Stripe sends people back to after checkout. Falls back to VERCEL_URL,
# then localhost. Set it explicitly on a custom domain.
NEXT_PUBLIC_APP_URL=

# Connections in the Postgres pool. Leave unset in production (defaults to 3).
# Set to 1 against the local `npm run dev:db` database: PGlite's socket server
# serves one session at a time, and a larger pool resets connections mid-query —
# it looks like the database falling over, and is only the pool being sized for
# a different server.
# PG_POOL_MAX=1
